# syntax=docker/dockerfile:1
# TurboQuant-Enhanced vLLM Image for DGX Spark
# Extends avarok/dgx-vllm-nvfp4-kernel with TurboQuant KV-Cache compression
FROM avarok/dgx-vllm-nvfp4-kernel:v23

LABEL description="vLLM + NVFP4 + TurboQuant (3-bit keys, 2-bit values)"
LABEL turboquant="enabled"

# Install TurboQuant from source
RUN git clone --depth 1 https://github.com/0xSero/turboquant.git /opt/turboquant && \
    cd /opt/turboquant && \
    pip install -e . && \
    rm -rf /opt/turboquant/.git && \
    python3 -c "from turboquant.vllm_attn_backend import enable_no_alloc; print('TurboQuant OK')"

# Copy custom entrypoint that patches vLLM with TurboQuant before model load
COPY turboquant-entrypoint.py /opt/turboquant-entrypoint.py
RUN chmod +x /opt/turboquant-entrypoint.py

# Override entrypoint – CMD will be passed as sys.argv[1:]
ENTRYPOINT ["python3", "/opt/turboquant-entrypoint.py"]
