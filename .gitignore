# LocalProxy — ignorierte Dateien
config.json
.env
.env.local
.env.*.local
*.bak
*.backup
*_backup_*

# Secrets (falls versehentlich angelegt)
secrets/
*.secret
*.key
!*.pubkey

# Caches / Temp / Test-Ergebnisse
.hindsight_memory/
__pycache__/
*.pyc
test_results_*.jsonl

# Plans (runtime-persistiert, Codespace-Copilot-Stil)
# Verzeichnis wird shipped (leer), Inhalt aber nicht committet:
data/plans/*
!data/plans/.gitkeep

# Debug-Dumps (runtime-persistiert, enthält keine Secrets, nur Outbound-Payloads)
# Verzeichnis wird shipped (leer), Inhalt aber nicht committet:
data/debug/*
!data/debug/.gitkeep

# Profile-Backups (enthalten API-Keys — niemals committen!)
data/profiles/*
!data/profiles/.gitkeep

# venvs
.venv/
.venv-1/

# Logs
*.log
proxy.log
